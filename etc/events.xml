<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">

    <event name="sales_model_service_quote_submit_before">
        <observer name="softcode_validate_and_map"
                  instance="Softcode\CheckoutOverride\Observer\ValidateAndMapQuoteToOrder"/>
    </event>

    <!-- Render varelinjerne som {{var items_html}} i ordre-mailen -->
    <event name="email_order_set_template_vars_before">
        <observer name="softcode_order_email_items"
                  instance="Softcode\CheckoutOverride\Observer\AddOrderEmailItems"/>
    </event>

</config>
