<?xml version="1.0"?>
<!--
    The module's order confirmation template ("Softcode order confirmation") is registered
    in email_templates.xml; select it under Sales Emails > Order if you want to use it.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <softcode_checkout>
            <general>
                <redirect_cart>1</redirect_cart>
            </general>
            <email>
                <payment_failed_enabled>0</payment_failed_enabled>
            </email>
        </softcode_checkout>
    </default>
</config>
